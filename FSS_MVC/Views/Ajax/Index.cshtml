@model List<FSS_MVC.ViewModels.NameVM>

<h1>University Course Report</h1>
<h2>This report combines Courses and Lecturers</h2>

<br />
<label for="hoursPerCredits">Hours Per Credits:</label>
@* <input type="number" id="hoursPerCredit" value="10" min="0" oninput="CalculateHours()" /> *@

<br />

<table class="table table-bordered table-striped">
	<thead>
		<tr>
			<th>Cource Code</th>
			<th>Cource Title</th>
			<th>Credits</th>
			<th>Lecturer</th>
			<th>Estimated Study Hours</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>@item.CourseCode</td>
				<td>@item.CourseTitle</td>
				<td>@item.Credits</td>
				<td>@item.LecturerName</td>
@* 				<td class="hours-cell" data-credits="@item.Credits">
					@item.EstimatedStudyHours
				</td> *@
			</tr>
		}
	</tbody>
</table>

<br />

<h3>Ajax Count Uni Courses</h3>
@* <button type="button" class="btn btn-primary" onclick="loadCourseCount()">Show Course Count</button>
<p id="courseCountResult"></p> *@

<br />


<h3>Public API Programming book Suggestion</h3>
