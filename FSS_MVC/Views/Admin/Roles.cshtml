@using Microsoft.AspNetCore.Identity
@model List<IdentityRole>
@{
    ViewData["Title"] = "Roles";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <h1 class="h3 mb-0"><i class="bi bi-shield-lock me-2"></i>Role Management</h1>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="CreateRole" method="post" class="row gy-2 gx-2 align-items-center">
                <div class="col-sm-6 col-md-4">
                    <label class="form-label" for="name">New role name</label>
                    <input id="name" name="name" class="form-control" placeholder="e.g., Manager" required />
                </div>
                <div class="col-auto d-flex align-items-end">
                    <button type="submit" class="btn btn-primary">
                        Create
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <strong><i class="bi bi-people me-2"></i>Existing Roles</strong>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Role Name</th>
                            <th scope="col" style="width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model is { Count: > 0 })
                        {
                            foreach (var role in Model)
                            {
                                <tr>
                                    <td class="fw-medium">@role.Name</td>
                                    <td>
                                        <form asp-action="DeleteRole" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@role.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                                    title="Delete role"
                                                    onclick="return confirm('Delete role @role.Name ?');">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="2" class="text-muted p-3">No roles yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
