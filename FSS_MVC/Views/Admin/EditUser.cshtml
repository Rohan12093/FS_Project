@model FSS_MVC.ViewModels.EditUserVM
@{
    ViewData["Title"] = "Edit User";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <h1 class="h3 mb-0"><i class="bi bi-person-badge me-2"></i>Edit User</h1>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="EditUser" method="post" novalidate>
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Roles</label>
                        @* Multi-select for roles *@
                        <select asp-for="SelectedRoles"
                                class="form-select"
                                multiple="multiple"
                                size="6"
                                asp-items="@(new MultiSelectList(Model.AvailableRoles, Model.SelectedRoles))">
                        </select>
                        <div class="form-text">
                            Hold <kbd>Ctrl</kbd>/<kbd>Cmd</kbd> to select multiple roles.
                        </div>
                        <span asp-validation-for="SelectedRoles" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Save
                    </button>
                    <a asp-action="Users" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
